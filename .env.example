# Florida Chicken Coops — environment configuration
# Copy this file to ".env" and fill in real values. The .env file is gitignored.

# --- Resend (the HTTPS API that SENDS the notification email — no SMTP) ---
# Setup, one time:
#   1. Create a free account at https://resend.com
#   2. Add the domain flchickencoops.com and add the DNS records Resend shows
#      you (SPF/DKIM) in Hostinger → Domains → DNS. Wait for it to verify.
#   3. Create an API key (it starts with "re_") and paste it below.
# RESEND_FROM must be an address on your verified domain. The display-name form
# ("Name <addr@domain>") is allowed. Until the domain is verified you can test
# with "onboarding@resend.dev", but that only delivers to your own Resend login.
RESEND_API_KEY=
RESEND_FROM=Florida Chicken Coops <quotes@flchickencoops.com>

# --- Recipients (who RECEIVES each submission) ---
CONTACT_RECEIVER=mitchell@flchickencoops.com
# Optional extra recipients, comma-separated (no spaces around commas):
CONTACT_CC=

# --- reCAPTCHA (disabled for now) ---
# Leave ENABLE_RECAPTCHA=0 to skip verification. To enable later, set it to 1
# and provide both keys, then add the widget to templates/contact.html.
ENABLE_RECAPTCHA=0
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
