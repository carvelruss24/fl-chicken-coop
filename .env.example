# Florida Chicken Coops — environment configuration
# Copy this file to ".env" and fill in real values. The .env file is gitignored.

# --- Resend (the HTTPS API that SENDS the notification email — no SMTP) ---
# Setup, one time:
#   1. Create a free account at https://resend.com
#   2. Add the domain flchickencoops.com and add the DNS records Resend shows
#      you (SPF/DKIM) in Hostinger → Domains → DNS. Wait for it to verify.
#   3. Create an API key (it starts with "re_") and paste it below.
# RESEND_FROM must be an address on your verified domain. The display-name form
# ("Name <addr@domain>") is allowed. Until the domain is verified you can test
# with "onboarding@resend.dev", but that only delivers to your own Resend login.
RESEND_API_KEY=
RESEND_FROM=Florida Chicken Coops <quotes@flchickencoops.com>

# --- Recipients (who RECEIVES each submission) ---
CONTACT_RECEIVER=Mitchellsisto@gmail.com
# Optional extra recipients, comma-separated (no spaces around commas):
CONTACT_CC=

# --- reCAPTCHA (disabled for now) ---
# Leave ENABLE_RECAPTCHA=0 to skip verification. To enable later, set it to 1
# and provide both keys, then add the widget to templates/contact.html.
ENABLE_RECAPTCHA=0
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=

# --- Admin dashboard (/admin) ---
# Sessions are signed with this key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Without it a random key is used per restart, so everyone gets logged out.
FLASK_SECRET_KEY=

# Seeded dashboard login. Leave these blank to use the development credential
# that ships in db.py (smashteam), then change the password from Account ->
# Change password. Set them here to seed a different login on a fresh database.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional: move the SQLite file somewhere else (default: instance/fcc.db).
DATABASE_PATH=

# Set to 1 once the site is served over HTTPS so the session cookie is
# marked Secure.
SESSION_COOKIE_SECURE=0

# Largest featured-image / in-body upload accepted, in megabytes.
MAX_UPLOAD_MB=8

# Domain shown in the editor's search-result preview (no scheme).
SITE_DOMAIN=www.flchickencoops.com

# Username prefilled on Account -> "Create the client account".
CLIENT_USERNAME=flchickencoops
